# ==========================================
# FILMVORA PLATFORM ENVIRONMENT VARIABLES
# ==========================================

# Backend Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/filmvora

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_super_secret_key_here
JWT_EXPIRES_IN=30d

# Node Environment ('development' or 'production')
NODE_ENV=development

# Frontend Client URL (CORS origin)
CLIENT_URL=http://localhost:5173
